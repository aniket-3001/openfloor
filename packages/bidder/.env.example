# The auction house origin. Setting this to a DIFFERENT origin than the bidder
# console is what makes the cross-origin path real rather than simulated.
VITE_API_BASE=http://localhost:8787
VITE_FLOOR_ORIGIN=http://localhost:5173
VITE_ROOM=main

# Persona for this console. Run several consoles on different ports with
# different personas to stage a live bid war.
VITE_PERSONA=you
