# Local development only.
#
# In a DEPLOYMENT these values are not used: the server generates /config.js
# from its own PUBLIC_* environment and the app reads window.__OPENFLOOR_CONFIG__
# at runtime. Build-time inlining pinned a bundle to whatever origins it was
# compiled against, which silently broke the first Cloud Run deploy — see
# docs/DEPLOYMENT.md.
#
# These remain as the local fallback, because `vite dev` serves no /config.js.

# The auction API. A DIFFERENT origin from this console is what makes the
# cross-origin path real rather than simulated.
VITE_API_BASE=http://localhost:8080
VITE_FLOOR_ORIGIN=http://localhost:5173
VITE_ROOM=main

# Persona for this console: you | ada | rex | nia
VITE_PERSONA=you
